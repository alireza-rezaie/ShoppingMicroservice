{
  "ConnectionStrings": {
    "AuthDb": "Data Source=auth.db"
  },
  "Jwt": {
    "Issuer": "ShoppingMicroservice.Authentication",
    "Audience": "ShoppingMicroservice",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}